{% extends "base.html.twig" %}

{% block title %}Profile - The Editorial Roast{% endblock %}

{% block content %}
<div class="bg-surface-container-low min-h-screen pb-20">
    <div class="max-w-7xl mx-auto px-8 pt-12 pb-8 flex flex-col md:flex-row gap-12 items-start">
        
        <!-- Left Sidebar: Profile Card & Nav -->
        <aside class="w-full md:w-80 flex-shrink-0 space-y-8">
            <!-- Flash Messages -->
            {% for message in app.flashes('success') %}
            <div class="bg-green-100 text-green-800 border border-green-200 rounded-lg px-4 py-3 text-sm font-body">
                {{ message }}
            </div>
            {% endfor %}

            <!-- Profile Card -->
            <div class="bg-surface rounded-2xl p-8 text-center shadow-sm relative overflow-hidden">
                <div class="absolute -bottom-10 -right-10 opacity-10 pointer-events-none">
                    <span class="material-symbols-outlined text-[8rem] text-primary">menu_book</span>
                </div>
                <div class="w-24 h-24 mx-auto rounded-xl overflow-hidden mb-4 shadow-md">
                    <img src="https://i.pravatar.cc/150?u={{ user.email }}" alt="{{ user.fullName }}" class="w-full h-full object-cover"/>
                </div>
                <h2 class="font-headline text-2xl font-bold text-on-surface tracking-tight">{{ user.fullName }}</h2>
                <p class="font-body text-sm text-on-surface-variant mt-1 mb-6">{{ user.email }}</p>
                <a href="{{ path('app_profile_edit') }}" class="inline-block bg-primary/90 hover:bg-primary text-on-primary font-bold py-2 px-6 rounded-md text-xs tracking-wider uppercase transition-colors">
                    Edit Profile
                </a>
            </div>

            <!-- Ledger Navigation -->
            <div class="space-y-2">
                <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-4 px-4">Account Ledger</p>
                <nav class="flex flex-col gap-1">
                    <a href="{{ path('app_profile') }}" class="flex items-center gap-4 px-4 py-3 rounded-lg bg-surface-container text-on-surface font-bold text-sm">
                        <span class="material-symbols-outlined text-[1.2rem] text-primary">person</span>
                        Personal Details
                    </a>
                    <a href="{{ path('app_profile') }}#orders" class="flex items-center gap-4 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface hover:text-primary transition-colors font-medium text-sm">
                        <span class="material-symbols-outlined text-[1.2rem]">history</span>
                        Order History
                    </a>
                    <a href="{{ path('app_profile_edit') }}" class="flex items-center gap-4 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface hover:text-primary transition-colors font-medium text-sm">
                        <span class="material-symbols-outlined text-[1.2rem]">settings</span>
                        Settings
                    </a>
                    <a href="{{ path('app_logout') }}" class="flex items-center gap-4 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface hover:text-red-600 transition-colors font-medium text-sm">
                        <span class="material-symbols-outlined text-[1.2rem]">logout</span>
                        Logout
                    </a>
                </nav>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-grow w-full space-y-12">
            
            <!-- Order History Table -->
            <section id="orders">
                <div class="flex justify-between items-end mb-6">
                    <div>
                        <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-1">Recent Acquisitions</p>
                        <h2 class="font-headline text-3xl font-extrabold text-on-surface">Order History</h2>
                    </div>
                </div>
                
                <div class="bg-surface rounded-xl overflow-hidden shadow-sm">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left font-body text-sm">
                            <thead>
                                <tr class="bg-surface-container border-b border-outline-variant/30 text-[10px] uppercase tracking-widest text-outline">
                                    <th class="px-6 py-4 font-bold">Order ID</th>
                                    <th class="px-6 py-4 font-bold">Date</th>
                                    <th class="px-6 py-4 font-bold">Items</th>
                                    <th class="px-6 py-4 font-bold">Status</th>
                                    <th class="px-6 py-4 font-bold text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/20 text-on-surface">
                                {% for order in orders %}
                                <tr class="hover:bg-surface-container-low transition-colors">
                                    <td class="px-6 py-5 font-bold">{{ order.reference }}</td>
                                    <td class="px-6 py-5 text-on-surface-variant">{{ order.createdAt|date('M d, Y') }}</td>
                                    <td class="px-6 py-5 text-on-surface-variant">{{ order.items|length }} item{{ order.items|length > 1 ? 's' : '' }}</td>
                                    <td class="px-6 py-5">
                                        {% if order.status == 'Dispatched' %}
                                        <span class="bg-secondary-container text-on-secondary-container px-3 py-1 rounded-full text-xs font-bold">{{ order.status }}</span>
                                        {% elseif order.status == 'Delivered' %}
                                        <span class="bg-surface-container text-on-surface-variant px-3 py-1 rounded-full text-xs font-bold">{{ order.status }}</span>
                                        {% elseif order.status == 'Pending' %}
                                        <span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-xs font-bold">{{ order.status }}</span>
                                        {% else %}
                                        <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-xs font-bold">{{ order.status }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-5 font-bold text-right">${{ order.totalAmount|number_format(2, '.', ',') }}</td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center text-on-surface-variant">
                                        <span class="material-symbols-outlined text-4xl text-outline/30 mb-2 block">receipt_long</span>
                                        No orders yet. <a href="{{ path('app_shop') }}" class="text-primary font-bold hover:underline">Start shopping</a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- Addresses & Payments Grid -->
            <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Shipping -->
                <div class="bg-surface p-8 rounded-xl shadow-sm border border-transparent hover:border-outline-variant/30 transition-colors">
                    <div class="w-10 h-10 bg-surface-container rounded-full flex items-center justify-center mb-6">
                        <span class="material-symbols-outlined text-primary text-xl">home</span>
                    </div>
                    <h3 class="font-headline text-lg font-bold text-on-surface mb-2">Shipping Address</h3>
                    {% if user.address %}
                    <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">{{ user.address }}</p>
                    {% else %}
                    <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">No address on file yet.</p>
                    {% endif %}
                    <a href="{{ path('app_profile_edit') }}" class="font-label text-xs font-bold text-primary flex items-center gap-1 hover:text-primary-dim transition-colors">
                        Edit Address <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                </div>

                <!-- Contact -->
                <div class="bg-surface p-8 rounded-xl shadow-sm border border-transparent hover:border-outline-variant/30 transition-colors">
                    <div class="w-10 h-10 bg-surface-container rounded-full flex items-center justify-center mb-6">
                        <span class="material-symbols-outlined text-primary text-xl">phone</span>
                    </div>
                    <h3 class="font-headline text-lg font-bold text-on-surface mb-2">Contact Info</h3>
                    <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">
                        {{ user.phone ?? 'No phone number on file.' }}
                    </p>
                    <a href="{{ path('app_profile_edit') }}" class="font-label text-xs font-bold text-primary flex items-center gap-1 hover:text-primary-dim transition-colors">
                        Edit Contact <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                </div>
            </section>

            <!-- Curated Content Block -->
            <section class="bg-secondary-container/30 rounded-2xl p-10 flex flex-col md:flex-row items-center gap-10">
                <div class="flex-grow">
                    <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-2">Your Space</p>
                    <h3 class="font-headline text-3xl font-extrabold text-on-surface mb-4">The Reader's Nook</h3>
                    <p class="font-body text-on-surface-variant max-w-sm mb-6">
                        We've noticed you enjoy our heavier roasts. Perfect for long afternoons lost in a classic novel or early mornings at your drafting table.
                    </p>
                    <a href="{{ path('app_shop') }}" class="font-bold text-sm text-primary border-b-2 border-primary/30 hover:border-primary pb-1 transition-colors">
                        Explore "The Library Selection"
                    </a>
                </div>
                <div class="w-full md:w-64 aspect-square bg-surface rounded-xl overflow-hidden shadow-md relative rotate-2">
                    <div class="absolute -top-4 -left-4 opacity-50">
                        <span class="material-symbols-outlined text-[4rem] text-primary">local_offer</span>
                    </div>
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuB1vElRcyIcrx2rFGqKs50DWmQ5dATiQsqx_Fiuwyi-BfCtEc_ga_NlH5cob5MOjLvP2osiXoxik_OAE0Z9SiEjvsKl58ss4hcpKaM2HbPki56qgiknlfq8KnE_ranQzydFTvdp_qYwozkupLO8DhATwvS8SN2qpgpl1xNfBpVNld8siCoxNeM2keYfsDNUaKIR5Fdo7dFO6ecrxKkgu89--De97BoyinpceQpTcoRUrBsh_dg8KSImzil4HzfUuKKnfVR5huRnO9o4" alt="Books and coffee" class="w-full h-full object-cover opacity-90"/>
                </div>
            </section>

        </main>
    </div>
</div>
{% endblock %}
