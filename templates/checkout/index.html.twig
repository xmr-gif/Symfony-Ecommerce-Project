{% extends "base.html.twig" %}

{% block title %}Checkout - The Editorial Roast{% endblock %}

{% block content %}
<div class="bg-surface-container-low min-h-screen pb-24">
    <div class="max-w-7xl mx-auto px-8 pt-12">
        <div class="mb-12">
            <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-2 block">Secure Checkout</span>
            <h1 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface tracking-tighter">Final Details.</h1>
        </div>

        {% for message in app.flashes('error') %}
            <div class="bg-error-container text-on-error-container px-4 py-3 rounded-md mb-8 text-sm font-body">
                {{ message }}
            </div>
        {% endfor %}

        <form method="POST" action="{{ path('app_checkout_process') }}" id="checkout-form" class="grid grid-cols-1 lg:grid-cols-3 gap-16">
            
            <!-- Left Side: Addresses & Payment -->
            <div class="lg:col-span-2 space-y-12">
                
                <!-- Shipping Address -->
                <section>
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="font-headline text-2xl font-bold text-on-surface">1. Shipping Address</h2>
                        <a href="{{ path('app_profile_add_address') }}" class="text-xs font-bold text-primary hover:text-primary-dim transition-colors">+ New Address</a>
                    </div>
                    
                    {% if user.addresses|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {% for address in user.addresses %}
                        <label class="cursor-pointer group relative">
                            <input type="radio" name="address_id" value="{{ address.id }}" class="peer absolute opacity-0" required>
                            <div class="bg-surface border-2 border-outline-variant/30 rounded-xl p-6 peer-checked:border-primary peer-checked:bg-primary/5 transition-colors h-full">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-bold text-on-surface group-hover:text-primary transition-colors">{{ address.label }}</span>
                                    <span class="material-symbols-outlined text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check_circle</span>
                                </div>
                                <p class="text-sm text-on-surface-variant font-body leading-relaxed">
                                    {{ address.line1 }}<br/>
                                    {{ address.city }}, {{ address.postalCode }}<br/>
                                    {{ address.country }}
                                </p>
                            </div>
                        </label>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="bg-surface rounded-xl p-8 text-center border border-outline-variant/30">
                        <p class="text-on-surface-variant mb-4">You don't have any saved addresses.</p>
                        <a href="{{ path('app_profile_add_address') }}" class="inline-block bg-primary text-on-primary font-bold px-6 py-2 rounded-md transition-transform active:scale-95 shadow-sm">
                            Add an Address
                        </a>
                    </div>
                    {% endif %}
                </section>

                <!-- Payment Method -->
                <section>
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="font-headline text-2xl font-bold text-on-surface">2. Payment Method</h2>
                        <a href="{{ path('app_profile_add_card') }}" class="text-xs font-bold text-primary hover:text-primary-dim transition-colors">+ New Card</a>
                    </div>
                    
                    {% if user.paymentCards|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {% for card in user.paymentCards %}
                        <label class="cursor-pointer group relative">
                            <input type="radio" name="card_id" value="{{ card.id }}" class="peer absolute opacity-0" required>
                            <div class="bg-surface border-2 border-outline-variant/30 rounded-xl p-6 peer-checked:border-primary peer-checked:bg-primary/5 transition-colors h-full flex flex-col justify-between">
                                <div class="flex items-center justify-between mb-6">
                                    <span class="material-symbols-outlined text-outline-variant">credit_card</span>
                                    <span class="material-symbols-outlined text-primary opacity-0 peer-checked:opacity-100 transition-opacity">check_circle</span>
                                </div>
                                <div>
                                    <p class="font-bold text-on-surface group-hover:text-primary transition-colors tracking-widest">{{ card.maskedNumber }}</p>
                                    <div class="flex items-center justify-between mt-2">
                                        <span class="text-xs text-on-surface-variant">{{ card.cardholderName }}</span>
                                        <span class="text-xs font-bold text-on-surface-variant">{{ "%02d"|format(card.expiryMonth) }}/{{ card.expiryYear }}</span>
                                    </div>
                                </div>
                            </div>
                        </label>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="bg-surface rounded-xl p-8 text-center border border-outline-variant/30">
                        <p class="text-on-surface-variant mb-4">You don't have any saved payment methods.</p>
                        <a href="{{ path('app_profile_add_card') }}" class="inline-block bg-primary text-on-primary font-bold px-6 py-2 rounded-md transition-transform active:scale-95 shadow-sm">
                            Add a Payment Card
                        </a>
                    </div>
                    {% endif %}
                </section>
            </div>

            <!-- Right Side: Order Summary -->
            <div class="lg:col-span-1">
                <div class="bg-surface rounded-2xl p-8 sticky top-32 shadow-sm border border-outline-variant/20">
                    <h3 class="font-headline text-xl font-bold text-on-surface mb-6">Order Summary</h3>

                    <div class="space-y-4 mb-6">
                        {% for item in items %}
                        <div class="flex justify-between items-center text-sm">
                            <div class="flex items-center gap-3">
                                <span class="font-bold text-primary">{{ item.quantity }}x</span>
                                <span class="text-on-surface font-medium truncate max-w-[150px]">{{ item.product.name }}</span>
                            </div>
                            <span class="text-on-surface-variant">${{ (item.product.price * item.quantity)|number_format(2, '.', ',') }}</span>
                        </div>
                        {% endfor %}
                    </div>

                    <div class="space-y-4 mb-8 text-sm font-body border-t border-outline-variant/30 pt-6">
                        <div class="flex justify-between text-on-surface-variant">
                            <span>Subtotal</span>
                            <span class="text-on-surface font-medium">${{ total|number_format(2, '.', ',') }}</span>
                        </div>
                        <div class="flex justify-between text-on-surface-variant">
                            <span>Shipping</span>
                            <span class="text-on-surface font-medium">Free</span>
                        </div>
                        <div class="border-t border-outline-variant/30 pt-4 flex justify-between text-on-surface">
                            <span class="font-bold">Total</span>
                            <span class="font-bold text-lg">${{ total|number_format(2, '.', ',') }}</span>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-gradient-to-br from-primary to-primary-dim text-on-primary font-bold py-4 rounded-md text-center transition-transform active:scale-[0.98] shadow-sm hover:shadow-md {% if user.addresses|length == 0 or user.paymentCards|length == 0 %}opacity-50 cursor-not-allowed pointer-events-none{% endif %}">
                        Confirm Order
                    </button>
                    
                    {% if user.addresses|length == 0 or user.paymentCards|length == 0 %}
                    <p class="text-[10px] text-error mt-4 text-center">Please add an address and payment method to continue.</p>
                    {% endif %}
                </div>
            </div>

        </form>
    </div>
</div>
{% endblock %}
