<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>{% block title %}The Editorial Roast | Ethically Sourced, Intentionally Brewed{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "secondary-dim": "#684d43",
                    "surface-container-low": "#f5f4ef",
                    "surface-container-highest": "#e2e3db",
                    "on-surface": "#30332e",
                    "inverse-surface": "#0e0e0d",
                    "outline": "#797c75",
                    "on-secondary-container": "#674b41",
                    "on-secondary-fixed": "#533930",
                    "on-secondary": "#fff7f5",
                    "on-background": "#30332e",
                    "surface-tint": "#745853",
                    "on-tertiary": "#fff7f5",
                    "on-surface-variant": "#5d605a",
                    "secondary-fixed-dim": "#f3ccbf",
                    "on-primary": "#fff6f4",
                    "surface-container": "#eeeee8",
                    "primary-dim": "#674c47",
                    "surface-variant": "#e2e3db",
                    "on-secondary-fixed-variant": "#72554b",
                    "on-tertiary-fixed": "#4e4644",
                    "surface": "#fbf9f5",
                    "tertiary": "#655d5a",
                    "on-primary-container": "#674b46",
                    "tertiary-fixed-dim": "#ece0dc",
                    "primary-fixed": "#ffdad4",
                    "secondary-container": "#ffdbce",
                    "primary": "#745853",
                    "surface-container-high": "#e8e9e2",
                    "primary-fixed-dim": "#f2ccc5",
                    "inverse-primary": "#fed7d0",
                    "outline-variant": "#b1b3ab",
                    "error": "#9e3f4e",
                    "on-primary-fixed-variant": "#715550",
                    "background": "#fbf9f5",
                    "on-error": "#fff7f7",
                    "on-tertiary-container": "#605855",
                    "surface-bright": "#fbf9f5",
                    "inverse-on-surface": "#9e9d99",
                    "tertiary-container": "#faeeea",
                    "tertiary-fixed": "#faeeea",
                    "error-dim": "#4f0116",
                    "secondary": "#75584e",
                    "on-primary-fixed": "#523935",
                    "secondary-fixed": "#ffdbce",
                    "tertiary-dim": "#59524f",
                    "on-error-container": "#782232",
                    "on-tertiary-fixed-variant": "#6b6360",
                    "surface-dim": "#d9dbd2",
                    "primary-container": "#ffdad4",
                    "surface-container-lowest": "#ffffff",
                    "error-container": "#ff8b9a"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
            },
            "fontFamily": {
                    "headline": ["Manrope"],
                    "body": ["Inter"],
                    "label": ["Inter"]
            }
          },
        },
      }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .bg-primary-gradient {
            background: linear-gradient(145deg, #745853 0%, #674c47 100%);
        }
        .editorial-lockup {
            letter-spacing: -0.02em;
        }
        .label-archival {
            letter-spacing: 0.05em;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-background text-on-surface font-body selection:bg-primary-container">

<!-- TopNavBar -->
<nav class="fixed top-0 w-full z-50 bg-[#fbf9f5]/80 dark:bg-[#30332e]/80 backdrop-blur-md shadow-[0_48px_48px_-12px_rgba(48,51,46,0.06)]">
    <div class="flex justify-between items-center max-w-7xl mx-auto px-8 h-20">
        <a href="{{ path('app_home') }}" class="text-2xl font-black text-[#4E342E] dark:text-[#f5f4ef] tracking-tighter font-headline">
            The Editorial Roast
        </a>
        <div class="hidden md:flex items-center space-x-12 font-headline tracking-tight font-bold">
            <a class="text-[#30332e]/70 dark:text-[#f5f4ef]/70 hover:text-[#745853] transition-colors duration-300" href="{{ path('app_browse_categories') }}">Shop</a>
            <a class="text-[#30332e]/70 dark:text-[#f5f4ef]/70 hover:text-[#745853] transition-colors duration-300" href="#">Story</a>
            <a class="text-[#30332e]/70 dark:text-[#f5f4ef]/70 hover:text-[#745853] transition-colors duration-300" href="#">Journal</a>
        </div>
        <div class="flex items-center space-x-6">
            <a href="{{ path('app_cart') }}" class="scale-95 active:scale-90 transition-transform text-[#4E342E] dark:text-[#f5f4ef]">
                <span class="material-symbols-outlined">shopping_cart</span>
            </a>
            <button class="scale-95 active:scale-90 transition-transform text-[#4E342E] dark:text-[#f5f4ef]">
                <span class="material-symbols-outlined">person</span>
            </button>
        </div>
    </div>
</nav>

<main class="pt-20">
    {% block content %}{% endblock %}
</main>

<!-- Footer -->
<footer class="w-full pt-16 pb-8 bg-[#f5f4ef] border-t border-surface-container">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 max-w-7xl mx-auto px-8">
        <div class="col-span-1 md:col-span-1">
            <div class="font-headline font-bold text-lg mb-4 text-[#4E342E]">The Editorial Roast</div>
            <p class="text-[#30332e]/60 font-body text-sm leading-relaxed">
                © 2024 The Editorial Roast. Ethically sourced, intentionally brewed.
            </p>
        </div>
        <div class="col-span-1">
            <h4 class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-6 block">Inquiries</h4>
            <div class="flex flex-col space-y-3 font-body text-sm tracking-wide text-[#30332e]/60">
                <a class="hover:underline decoration-[#745853] decoration-2 underline-offset-4 opacity-80 hover:opacity-100 transition-opacity" href="#">Contact</a>
                <a class="hover:underline decoration-[#745853] decoration-2 underline-offset-4 opacity-80 hover:opacity-100 transition-opacity" href="#">Wholesale</a>
            </div>
        </div>
        <div class="col-span-1">
            <h4 class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-6 block">Support</h4>
            <div class="flex flex-col space-y-3 font-body text-sm tracking-wide text-[#30332e]/60">
                <a class="hover:underline decoration-[#745853] decoration-2 underline-offset-4 opacity-80 hover:opacity-100 transition-opacity" href="#">Shipping</a>
                <a class="hover:underline decoration-[#745853] decoration-2 underline-offset-4 opacity-80 hover:opacity-100 transition-opacity" href="#">Privacy</a>
            </div>
        </div>
        <div class="col-span-1">
            <h4 class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-6 block">Newsletter</h4>
            <div class="relative">
                <input class="w-full bg-transparent border-b border-outline/30 focus:border-primary focus:ring-0 px-0 py-2 text-sm placeholder:text-outline/50 transition-colors" placeholder="Email Address" type="email"/>
                <button class="absolute right-0 bottom-2 text-primary font-bold text-sm tracking-tighter">Sign Up</button>
            </div>
        </div>
    </div>
    <div class="max-w-7xl mx-auto px-8 mt-16 pt-8 border-t border-surface-container flex flex-col md:flex-row justify-between items-center text-[10px] text-outline tracking-widest uppercase">
        <span>Volume No. 04 / extraction</span>
        <span class="mt-4 md:mt-0">Designed for the slow ritual</span>
    </div>
</footer>

{% block body %}{% endblock %}
</body>
</html>
