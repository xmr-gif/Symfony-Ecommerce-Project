{% extends "base.html.twig" %}

{% block title %}{{ category.name }} - The Editorial Roast{% endblock %}

{% block content %}
<!-- Title Section -->
<div class="mb-16 relative pt-12 max-w-7xl mx-auto px-8">
    <div class="flex items-end gap-4">
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter text-on-surface">{{ category.name }}</h1>
        <div class="mb-2">
            <span class="material-symbols-outlined text-primary text-4xl">coffee</span>
        </div>
    </div>
    <p class="mt-4 text-on-surface-variant max-w-lg font-body leading-relaxed">
        {{ category.description }}
    </p>
</div>

<div class="flex flex-col md:flex-row gap-16 max-w-7xl mx-auto px-8 pb-24">
    <!-- Filter Sidebar -->
    <aside class="w-full md:w-64 flex-shrink-0">
        <div class="sticky top-32 space-y-12">
            <div>
                <h3 class="font-label text-xs font-bold tracking-[0.2em] text-outline mb-6 uppercase">Origin</h3>
                <div class="space-y-4">
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-4 h-4 rounded-sm border border-outline-variant group-hover:border-primary transition-colors"></div>
                        <span class="text-sm font-medium text-on-surface-variant group-hover:text-primary transition-colors">Ethiopia</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-4 h-4 rounded-sm border border-outline-variant group-hover:border-primary transition-colors"></div>
                        <span class="text-sm font-medium text-on-surface-variant group-hover:text-primary transition-colors">Colombia</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-4 h-4 rounded-sm border border-outline-variant group-hover:border-primary transition-colors"></div>
                        <span class="text-sm font-medium text-on-surface-variant group-hover:text-primary transition-colors">Guatemala</span>
                    </label>
                </div>
            </div>
            <div>
                <h3 class="font-label text-xs font-bold tracking-[0.2em] text-outline mb-6 uppercase">Roast Level</h3>
                <div class="space-y-4">
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-4 h-4 rounded-sm border border-outline-variant group-hover:border-primary transition-colors"></div>
                        <span class="text-sm font-medium text-on-surface-variant group-hover:text-primary transition-colors">Light Roast</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-4 h-4 rounded-sm border border-outline-variant group-hover:border-primary transition-colors"></div>
                        <span class="text-sm font-medium text-on-surface-variant group-hover:text-primary transition-colors">Medium Roast</span>
                    </label>
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <div class="w-4 h-4 rounded-sm border border-outline-variant group-hover:border-primary transition-colors"></div>
                        <span class="text-sm font-medium text-on-surface-variant group-hover:text-primary transition-colors">Dark Roast</span>
                    </label>
                </div>
            </div>
        </div>
    </aside>

    <!-- Products Grid -->
    <div class="flex-grow">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-16 gap-x-12">
            {% for product in products %}
            <a href="{{ path('app_product_detail', {'slug': product.slug}) }}" class="group cursor-pointer block">
                <div class="relative aspect-[4/5] bg-surface-container-low mb-6 overflow-hidden">
                    {% if product.imageUrl %}
                    <img alt="{{ product.name }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="{{ product.imageUrl }}"/>
                    {% else %}
                    <div class="w-full h-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-6xl text-outline/30">coffee</span>
                    </div>
                    {% endif %}
                    {% if product.badge %}
                    <div class="absolute top-4 right-4 bg-surface/90 backdrop-blur-sm px-3 py-1 rounded-sm text-[10px] font-bold tracking-widest uppercase text-primary">{{ product.badge }}</div>
                    {% endif %}
                </div>
                <div class="space-y-1">
                    <h4 class="text-xl font-bold tracking-tight text-on-surface">{{ product.name }}</h4>
                    {% if product.tastingNotes %}
                    <p class="text-sm text-on-surface-variant font-body">{{ product.tastingNotes }}</p>
                    {% endif %}
                    <div class="pt-2 text-lg font-bold text-primary">${{ product.price|number_format(2, '.', ',') }}</div>
                </div>
            </a>
            {% else %}
            <div class="col-span-3 text-center py-20">
                <span class="material-symbols-outlined text-6xl text-outline/30 mb-4">inventory_2</span>
                <p class="text-on-surface-variant font-body">No products found in this category.</p>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
