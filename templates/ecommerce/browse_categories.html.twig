{# Etape 1 & 2 modifications remade by Oussama #}
{% extends "base.html.twig" %}

{% block title %}Browse Categories - The Editorial Roast{% endblock %}

{% block content %}
<!-- Hero Section -->
<header class="max-w-7xl mx-auto px-8 mb-20 pt-12">
    <div class="max-w-2xl">
        <span class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-4 block">Archive &amp; Inventory</span>
        <h1 class="text-6xl md:text-7xl font-extrabold text-on-surface tracking-tighter leading-none mb-8">
            The Extraction <br/><span class="text-primary italic">Catalogue.</span>
        </h1>
        <p class="text-lg text-on-surface-variant font-body leading-relaxed max-w-md">
            Explore our curated selections, from micro-lot beans to the architectural ceramics we use in-house. Every item is a ledger of quality.
        </p>
    </div>
</header>

<!-- Category Grid (Bento Style) -->
<section class="max-w-7xl mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-24">
        <!-- Large Featured Category: Coffee Beans -->
        {% if categories|length > 0 %}
        <a href="{{ path('app_products_by_category', {'slug': categories[0].slug}) }}" class="md:col-span-8 group relative overflow-hidden bg-surface-container-low p-12 min-h-[500px] flex flex-col justify-end hover:shadow-lg transition-shadow">
            <div class="absolute top-12 right-12 opacity-20 group-hover:opacity-40 transition-opacity duration-700">
                <span class="material-symbols-outlined text-[12rem]">eco</span>
            </div>
            <div class="relative z-10">
                <span class="font-label text-[10px] uppercase tracking-[0.2em] text-primary font-bold mb-2 block">Featured</span>
                <h2 class="text-4xl font-extrabold mb-4 tracking-tight">{{ categories[0].name }}</h2>
                <p class="text-on-surface-variant max-w-xs mb-8">{{ categories[0].description }}</p>
                <button class="bg-gradient-to-br from-primary to-primary-dim text-on-primary px-6 py-3 rounded-md text-sm font-semibold tracking-tight shadow-sm hover:scale-95 transition-transform">
                    Explore Collection
                </button>
            </div>
        </a>
        {% endif %}

        <!-- Display remaining categories in smaller grid -->
        {% if categories|length > 1 %}
            {% set remaining = categories|slice(1) %}
            
            <!-- Small Category Cards -->
            {% for cat in remaining %}
            <a href="{{ path('app_products_by_category', {'slug': cat.slug}) }}" class="md:col-span-4 group bg-surface-container p-8 flex flex-col justify-between hover:bg-surface-container-high transition-colors duration-500">
                <div>
                    <div class="mb-6 w-12 h-12 bg-surface-container-lowest flex items-center justify-center rounded-lg shadow-sm">
                        <span class="material-symbols-outlined text-primary">coffee_maker</span>
                    </div>
                    <h3 class="text-2xl font-bold tracking-tight mb-2">{{ cat.name }}</h3>
                    <p class="text-sm text-on-surface-variant">{{ cat.description }}</p>
                </div>
                <span class="text-sm font-bold border-b-2 border-primary-container pb-1 inline-block w-fit mt-8 hover:border-primary transition-colors">Explore</span>
            </a>
            {% endfor %}
        {% endif %}
    </div>
</section>
{% endblock %}
