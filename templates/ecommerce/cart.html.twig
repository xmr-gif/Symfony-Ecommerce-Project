{% extends "base.html.twig" %}

{% block title %}Your Cart - The Editorial Roast{% endblock %}

{% block content %}
<main class="pt-12 pb-24 max-w-7xl mx-auto px-8">
    <!-- Hero Title Section -->
    <header class="mb-16">
        <span class="label-md uppercase tracking-[0.2em] text-primary font-semibold text-xs mb-3 block">Your Selection</span>
        <h1 class="text-5xl md:text-6xl font-extrabold tracking-tighter text-on-surface max-w-2xl leading-[1.1]">The items you've curated for your morning.</h1>
    </header>

    <div class="flex flex-col md:flex-row gap-16">
        <!-- Cart Items List -->
        <section class="flex-grow space-y-12">
            <!-- Cart Item 1 -->
            <div class="flex flex-col md:flex-row gap-8 items-start group">
                <div class="w-full md:w-48 aspect-square bg-surface-variant overflow-hidden rounded-md relative">
                    <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDHnRu6uWQjPd1m4jfboXlcqZyMo-WSjXnwyJo0llS-jDDxzl0_XBf900OplHmsOGOHsrFo4epBKmKH33l-Eky9dVmL72JspT7uNiqMtLNuXNx-LRRJelqVjQKH9NUIT-nHU3byEfqfhoBeWJIqMUQKjyH0rwLk1BZqAb0vSTETbUq_4_YOrDzQNCf7PF3TvxNrMKL8v2JfH9mneq_4S9vPZFkdi-lNN1hnVpileOfXAw59de6fcDXC1faKfukJadm4h0ikq1Egzn5o"/>
                </div>
                <div class="flex-grow py-2">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-2xl font-bold font-headline tracking-tight text-on-surface">The Alchemist Blend</h3>
                            <p class="text-on-surface-variant font-body mt-1">Whole Bean • 250g • Dark Roast</p>
                        </div>
                        <span class="text-xl font-bold font-headline">$24.00</span>
                    </div>
                    <div class="flex items-center gap-8 mt-6">
                        <div class="flex items-center bg-surface-container rounded-md px-3 py-1">
                            <button class="p-1 hover:text-primary"><span class="material-symbols-outlined text-sm">remove</span></button>
                            <span class="px-4 font-bold text-on-surface">1</span>
                            <button class="p-1 hover:text-primary"><span class="material-symbols-outlined text-sm">add</span></button>
                        </div>
                        <button class="text-on-surface-variant hover:text-error transition-colors flex items-center gap-2 text-sm uppercase tracking-widest font-bold">
                            <span class="material-symbols-outlined text-lg">close</span> Remove
                        </button>
                    </div>
                </div>
            </div>

            <!-- Cart Item 2 -->
            <div class="flex flex-col md:flex-row gap-8 items-start group">
                <div class="w-full md:w-48 aspect-square bg-surface-variant overflow-hidden rounded-md relative">
                    <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD5xxfCj70N2UPXjXopw7iEiNeTESRxI9XZhIQwnccPihud7jQfSuYU4XpMJgYd-l9s_21qX6Y4mI3OEoDAE_wsKF9qeJUNandCzNt4uwRtijJuUWXBFIe6ugqH3qZBC-3Gp8M4634y_q7jtkFYHNn-263NOg9jnU4VI1nHxoWZghMy2M9NDQo2E4qRL014D3gwKgbF6Vt2BkKxP5D8iMrvNGAWByDHjCIE12jHO9R0--kARUY1NhX2JC6rw36-cLptNXrhB06KDpG3"/>
                </div>
                <div class="flex-grow py-2">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-2xl font-bold font-headline tracking-tight text-on-surface">Precision Glass Dripper</h3>
                            <p class="text-on-surface-variant font-body mt-1">Manual Brew • Borosilicate Glass</p>
                        </div>
                        <span class="text-xl font-bold font-headline">$48.00</span>
                    </div>
                    <div class="flex items-center gap-8 mt-6">
                        <div class="flex items-center bg-surface-container rounded-md px-3 py-1">
                            <button class="p-1 hover:text-primary"><span class="material-symbols-outlined text-sm">remove</span></button>
                            <span class="px-4 font-bold text-on-surface">1</span>
                            <button class="p-1 hover:text-primary"><span class="material-symbols-outlined text-sm">add</span></button>
                        </div>
                        <button class="text-on-surface-variant hover:text-error transition-colors flex items-center gap-2 text-sm uppercase tracking-widest font-bold">
                            <span class="material-symbols-outlined text-lg">close</span> Remove
                        </button>
                    </div>
                </div>
            </div>

            <!-- Hand-drawn Doodle Decoration -->
            <div class="mt-20 opacity-20 pointer-events-none">
                <svg class="text-on-surface" height="180" viewbox="0 0 200 200" width="180">
                    <path d="M40,160 L160,160 L170,60 L30,60 Z" fill="none" stroke="currentColor" stroke-width="2"></path>
                    <path d="M30,60 Q20,30 50,30 L150,30 Q180,30 170,60" fill="none" stroke="currentColor" stroke-width="2"></path>
                    <path d="M100,30 L100,160" fill="none" stroke="currentColor" stroke-dasharray="4" stroke-width="1"></path>
                </svg>
            </div>
        </section>

        <!-- Sidebar Summary -->
        <aside>
            <div class="bg-surface-container-low p-10 rounded-xl">
                <h2 class="text-3xl font-black tracking-tighter mb-8">Order Ledger</h2>
                <div class="space-y-6">
                    <div class="flex justify-between items-center">
                        <span class="text-on-surface-variant font-body">Subtotal</span>
                        <span class="font-bold text-lg">$72.00</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-on-surface-variant font-body">Shipping</span>
                        <span class="font-body italic text-sm">Calculated at next step</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-on-surface-variant font-body">Est. Taxes</span>
                        <span class="font-bold">$5.76</span>
                    </div>
                    <div class="h-px bg-outline-variant/20 my-4"></div>
                    <div class="flex justify-between items-center pt-2">
                        <span class="text-xl font-black uppercase tracking-widest">Total</span>
                        <span class="text-3xl font-black tracking-tight text-primary">$77.76</span>
                    </div>
                    <button class="w-full mt-10 py-5 bg-gradient-to-br from-primary to-primary-dim text-on-primary rounded-md font-bold tracking-tight text-lg shadow-xl hover:scale-[1.02] active:scale-95 transition-all">
                        Proceed to Checkout
                    </button>
                    <p class="text-center text-xs text-on-surface-variant font-body mt-6">
                        Secure encryption. Ethically sourced logistics.
                    </p>
                </div>

                <!-- Stack of Coffee Bags Doodle -->
                <div class="mt-16 flex justify-center">
                    <svg class="text-primary/40 stroke-current" fill="none" height="120" viewbox="0 0 100 100" width="120">
                        <rect height="50" rx="2" stroke-width="1.5" width="35" x="25" y="40"></rect>
                        <path d="M25,50 L60,50" stroke-width="1"></path>
                        <rect height="50" rx="2" stroke-width="1.5" width="35" x="45" y="30"></rect>
                        <path d="M45,40 L80,40" stroke-width="1"></path>
                        <path d="M60,20 Q65,10 70,20 T80,20" stroke-width="1"></path>
                    </svg>
                </div>
            </div>
        </aside>
    </div>
</main>
{% endblock %}
