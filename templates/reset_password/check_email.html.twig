{% extends 'base.html.twig' %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block content %}
<section class="min-h-[85vh] bg-surface-container-low flex items-center justify-center py-20 px-8">
    <div class="max-w-md w-full bg-surface p-12 rounded-2xl shadow-sm text-center">
        <span class="material-symbols-outlined text-[4rem] text-primary mb-4 block">mark_email_read</span>
        <h1 class="font-headline text-3xl font-extrabold text-on-surface mb-6">Password Reset Email Sent</h1>
        <p class="font-body text-on-surface-variant text-sm mb-6 leading-relaxed">
            If an account matching your email exists, then an email was just sent that contains a link that you can use to reset your password.
            This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
        </p>
        <p class="font-body text-on-surface-variant text-sm mb-8 leading-relaxed">
            If you don't receive an email please check your spam folder or <a href="{{ path('app_forgot_password_request') }}" class="text-primary hover:underline font-bold">try again</a>.
        </p>
        <div class="mt-8 border-t border-surface-container pt-8">
            <a href="{{ path('app_login') }}" class="text-sm font-bold text-primary hover:underline transition-colors">Return to Login</a>
        </div>
    </div>
</section>
{% endblock %}
