{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block content %}
<section class="min-h-[85vh] bg-surface-container-low flex items-center justify-center py-20 px-8">
    <div class="max-w-md w-full bg-surface p-12 rounded-2xl shadow-sm relative">
        <h1 class="font-headline text-3xl font-extrabold text-on-surface mb-6">Reset your password</h1>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="bg-error-container text-on-error-container px-4 py-3 rounded-md mb-6 text-sm font-body" role="alert">{{ flash_error }}</div>
        {% endfor %}

        <p class="font-body text-on-surface-variant text-sm mb-8 leading-relaxed">
            Enter your email address and we will send you a link to reset your password.
        </p>

        {{ form_start(requestForm, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
            <div>
                {{ form_label(requestForm.email, null, {'label_attr': {'class': 'block font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-2'}}) }}
                {{ form_widget(requestForm.email, {'attr': {'class': 'w-full bg-surface-container-low border border-outline/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-md px-4 py-3 text-on-surface font-body transition-colors'}}) }}
                {{ form_errors(requestForm.email) }}
            </div>

            <button class="w-full bg-primary-gradient text-on-primary font-bold py-4 rounded-md mt-4 transition-transform active:scale-[0.98] shadow-sm">
                Send password reset email
            </button>
        {{ form_end(requestForm) }}
        
        <div class="mt-8 text-center border-t border-surface-container pt-8">
            <a href="{{ path('app_login') }}" class="text-sm font-bold text-primary hover:underline transition-colors pb-0.5">Back to Login</a>
        </div>
    </div>
</section>
{% endblock %}
