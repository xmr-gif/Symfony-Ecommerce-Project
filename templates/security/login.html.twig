{% extends "base.html.twig" %}

{% block title %}Login - The Editorial Roast{% endblock %}

{% block content %}
<section class="min-h-[85vh] bg-surface-container-low flex items-center justify-center py-20 px-8">
    <div class="max-w-6xl w-full grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <!-- Left Side: Copy & Illustration -->
        <div class="hidden md:block">
            <p class="font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-4">Welcome Back</p>
            <h1 class="font-headline text-5xl lg:text-7xl font-extrabold text-on-surface tracking-tighter leading-[1.1] mb-8">
                Your Daily <br/>Ritual Awaits.
            </h1>
            <p class="font-body text-on-surface-variant max-w-sm mb-12 leading-relaxed">
                Sign in to manage your coffee subscriptions and view your recent artisanal roasts.
            </p>
            <!-- Decorative Element -->
            <div class="relative w-80 h-80 bg-surface-container rounded-xl rotate-[-3deg] shadow-lg flex items-center justify-center overflow-hidden">
                <img alt="Coffee illustration" class="w-full h-full object-cover opacity-90" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDZ5rkGJa7VuSQB6WKy0eXD8fgo06LqBsdLcehwxQg8nk3wpEn3bszHmi-yC3i4YDFw39T13kXuBAxfyc6bDNf1sb9mpiFeH_iIS_Dwcip0ZqBWs1BOVFvfj5nIynAYSL8nGUlxTB86qdVoAD7avAtcJPaut8tyKT1QVFL2J8f6nCKD_rsTZm7MDVHgfvEG9OK2IYbVzjU88diYwCAqNWXt5jzAJRckWl0SW72lS5Dg4gFFwHwTb0b5Ws1pouzZUhev6ItmWC8emfd7"/>
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="bg-surface p-12 rounded-2xl shadow-sm relative">
            <div class="absolute -top-6 -right-6 opacity-20 pointer-events-none">
                <span class="material-symbols-outlined text-[6rem] text-primary">eco</span>
            </div>
            
            <h2 class="font-headline text-4xl font-extrabold text-on-surface mb-10">Login</h2>

            {% if error %}
                <div class="bg-error-container text-on-error-container px-4 py-3 rounded-md mb-6 text-sm font-body">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="space-y-8">
                <!-- Email Field -->
                <div>
                    <label for="username" class="block font-label text-[10px] uppercase tracking-[0.2em] text-outline mb-2">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="w-full bg-surface-container-low border border-outline/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-md px-4 py-3 text-on-surface font-body transition-colors" placeholder="hello@roast.com" required autofocus>
                </div>

                <!-- Password Field -->
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label for="password" class="block font-label text-[10px] uppercase tracking-[0.2em] text-outline">Password</label>
                        <a href="#" class="text-[10px] font-bold text-primary hover:text-primary-dim transition-colors">Forgot Password?</a>
                    </div>
                    <input type="password" name="_password" id="password" class="w-full bg-surface-container-low border border-outline/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-md px-4 py-3 text-on-surface font-body transition-colors" placeholder="••••••••" required>
                </div>

                <!-- CSRF Token -->
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <!-- Submit Button -->
                <button type="submit" class="w-full bg-primary-gradient text-on-primary font-bold py-4 rounded-md mt-4 transition-transform active:scale-[0.98] shadow-sm">
                    Enter The Roast
                </button>
            </form>

            <div class="mt-12 text-center border-t border-surface-container pt-8">
                <p class="text-sm text-on-surface-variant font-body">
                    New to the ledger? 
                    <a href="#" class="font-bold text-primary border-b border-primary/30 hover:border-primary transition-colors pb-0.5">Create Account</a>
                </p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
